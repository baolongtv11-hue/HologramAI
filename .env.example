# Gemini API key: giữ ở backend, KHÔNG đưa vào HTML hoặc localStorage.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Model Live hiện hành theo danh mục model của Google.
GEMINI_LIVE_MODEL=gemini-3.8-live

# YouTube Data API v3 (không bắt buộc; chỉ cần nếu muốn tìm video bằng giọng nói).
YOUTUBE_API_KEY=

# Cổng backend. Mặc định 8787 ở chế độ phát triển và 8080 khi chạy production.
PORT=8080
API_PORT=8787
